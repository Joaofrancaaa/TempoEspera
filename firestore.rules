rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validReport(key) {
      let report = request.resource.data.reports.get(key, {});
      let before = resource.data.get('reports', {});
      let previous = before.get(key, {});
      return report is map
        && report.keys().hasOnly(['uid', 'filaKey', 'level', 'ts'])
        && report.uid == request.auth.uid
        && report.filaKey == request.resource.data.lastFilaKey
        && report.level in ['vazio', 'moderado', 'demorado']
        && report.ts == request.time
        && (
          !(key in before)
          || (
            previous is map
            && previous.get('ts', request.time) < request.time - duration.value(10, 'm')
          )
        );
    }

    function validSingleReport() {
      let fila = request.resource.data.lastFilaKey;
      let before = resource.data.get('reports', {});
      let after = request.resource.data.reports;
      let key = request.auth.uid + '_' + fila;
      return fila is string
        && fila.size() > 2
        && fila.size() < 40
        && before is map
        && after is map
        && after.diff(before).removedKeys().size() == 0
        && after.diff(before).affectedKeys().hasOnly([key])
        && validReport(key);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /stations/{stationId} {
      allow read: if true;
      allow create, delete: if false;

      allow update: if request.auth != null
        && request.resource.data.keys().hasAll(['name', 'lat', 'lng', 'reports', 'lastFilaKey'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports', 'lastFilaKey'])
        && validSingleReport();
    }
  }
}
